// CI/CD for OAS catalogue services. This repo owns the pipeline: it checks out the
// app repo (app_repo.url in services/<SERVICE>.config.yaml), builds its Dockerfile,
// pushes to ECR, and deploys via the shared Helm chart.
//
// Press-button: no build parameters. SERVICE comes from the job name (SERVICE_BY_JOB
// below); bastion/node/nginx IPs are discovered from EC2 Name tags via aws-credentials.
// Image tag = the app commit SHA (immutable); deploy is gated by `helm --wait`.
// Onboard a service: add a SERVICE_BY_JOB entry + a pipelineJob in casc.yaml.
//
// A service whose config declares keycloak_realm.realm_setup_script also gets its identity
// provider configured from the same button: the stage runs that script (from the APP checkout,
// so realm config ships with the code that needs it) against the live Keycloak over a bastion
// tunnel. Requires jq on the agent — see the Jenkins repo's Dockerfile.
pipeline {
    agent any

    environment {
        EC2_USER = "ubuntu"
        NAME_PREFIX = "oas-uat"   // EC2 tags: <NAME_PREFIX>-bastion / -nginx / -K8s-Node
    }

    stages {
        stage('Load Config') {
            steps {
                script {
                    // SERVICE from the job name (agri's job name != its SERVICE, so map explicitly).
                    def SERVICE_BY_JOB = [
                        'agri-catalogue-service'         : 'agri-catalogue',
                        'org-user-notification-services' : 'org-user-notification-services',
                        'oas-auth-service'               : 'oas-auth-service',
                    ]
                    def jobLeaf = env.JOB_NAME.tokenize('/').last()
                    env.SERVICE = SERVICE_BY_JOB[jobLeaf]
                    if (!env.SERVICE) {
                        error("No SERVICE mapping for job '${jobLeaf}'. Add it to SERVICE_BY_JOB in jenkins/Jenkinsfile.")
                    }

                    def configFile = "services/${env.SERVICE}.config.yaml"
                    if (sh(script: "test -f ${configFile}", returnStatus: true) != 0) {
                        error("Service config not found: ${configFile}")
                    }
                    // read fields from the service config
                    def cfg = { key ->
                        sh(
                            script: "grep -E '^[[:space:]]*${key}:' ${configFile} | head -1 | awk '{print \$2}'",
                            returnStdout: true
                        ).trim()
                    }
                    env.ECR_REPO_NAME   = cfg('ecr_repository_name')
                    env.ECR_REGION      = cfg('ecr_region')
                    env.HELM_RELEASE    = cfg('release_name')
                    env.HELM_CHART      = cfg('chart_path')      // shared: helm/oas-catalogue
                    env.HELM_VALUES     = cfg('values_file')     // e.g. values-agri-catalogue.yaml
                    env.APP_NAMESPACE   = cfg('namespace')
                    env.SECRET_NAME     = cfg('secret_name')     // <service>-secrets
                    // DB user from config; password from per-service Jenkins secret db-password-<SERVICE>.
                    env.DB_USERNAME     = cfg('username')
                    env.DB_CRED_ID      = "db-password-${env.SERVICE}"
                    env.APP_REPO_URL    = cfg('url')
                    env.APP_REPO_BRANCH = cfg('branch')
                    // Secret strategy: 'db-es' (default, catalogue) or 'keycloak' (auth).
                    env.SECRET_PROVIDER   = cfg('provider') ?: 'db-es'
                    env.KC_SECRET_CRED_ID = cfg('client_secret_cred_id')

                    // Optional realm-configuration stage (auth only). Values in the env: block are
                    // quoted, so strip them; the realm host is derived from KEYCLOAK_BASE_URL rather
                    // than repeated, so the DB-host IP stays declared in exactly one place.
                    def cfgq = { key -> cfg(key).replaceAll('"', '') }
                    env.REALM_SETUP_SCRIPT = cfg('realm_setup_script')
                    env.KC_ADMIN_CRED_ID   = cfg('admin_cred_id')
                    if (env.REALM_SETUP_SCRIPT) {
                        def kcUrl = cfgq('KEYCLOAK_BASE_URL')
                        // sed, not a Groovy Matcher: matchers are not CPS-serializable.
                        env.KC_HOST = sh(script: "printf %s '${kcUrl}' | sed -E 's#^https?://##; s#[:/].*##'",
                                         returnStdout: true).trim()
                        env.KC_PORT = sh(script: "printf %s '${kcUrl}' | sed -E 's#^https?://[^:/]+:?##; s#/.*##'",
                                         returnStdout: true).trim() ?: '8081'
                        env.KC_REALM     = cfgq('KEYCLOAK_REALM')
                        env.KC_CLIENT_ID = cfgq('KEYCLOAK_CLIENT_ID')
                        if (!env.KC_ADMIN_CRED_ID) {
                            error("keycloak_realm.realm_setup_script is set for ${env.SERVICE} but " +
                                  "admin_cred_id is not — the script needs Keycloak master admin credentials.")
                        }
                        echo "Keycloak realm : ${env.KC_REALM} on ${env.KC_HOST}:${env.KC_PORT} " +
                             "(client ${env.KC_CLIENT_ID}, script ${env.REALM_SETUP_SCRIPT})"
                    }

                    // Account ID + live host IPs from AWS (EC2 Name tags) — survives IP changes (no EIP).
                    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                        env.AWS_ACCOUNT_ID = sh(
                            script: "aws sts get-caller-identity --query Account --output text",
                            returnStdout: true
                        ).trim()
                        def ec2ip = { nameTag, field ->
                            sh(
                                script: "aws ec2 describe-instances --region ${env.ECR_REGION} " +
                                        "--filters 'Name=tag:Name,Values=${nameTag}' 'Name=instance-state-name,Values=running' " +
                                        "--query 'Reservations[0].Instances[0].${field}' --output text",
                                returnStdout: true
                            ).trim()
                        }
                        env.BASTION_HOST    = ec2ip("${env.NAME_PREFIX}-bastion",  'PublicIpAddress')
                        env.NODE_PRIVATE_IP = ec2ip("${env.NAME_PREFIX}-K8s-Node", 'PrivateIpAddress')
                        env.NGINX_HOST      = ec2ip("${env.NAME_PREFIX}-nginx",    'PublicIpAddress')
                    }
                    def missing = { v -> v == null || v == '' || v == 'None' }
                    if (missing(env.BASTION_HOST)) {
                        error("Could not discover the bastion IP (tag ${env.NAME_PREFIX}-bastion, running). " +
                              "Is the instance up, and does aws-credentials allow ec2:DescribeInstances?")
                    }
                    if (missing(env.NODE_PRIVATE_IP)) {
                        error("Could not discover the k8s node private IP (tag ${env.NAME_PREFIX}-K8s-Node, running).")
                    }
                    env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.ECR_REGION}.amazonaws.com"
                    env.ECR_REPO     = "${env.ECR_REGISTRY}/${env.ECR_REPO_NAME}"

                    echo "Service       : ${env.SERVICE}"
                    echo "Deploy target : ${env.NODE_PRIVATE_IP} via bastion ${env.BASTION_HOST}"
                    echo "nginx public  : ${env.NGINX_HOST}"
                    echo "ECR repository: ${env.ECR_REPO}"
                    echo "Helm release  : ${env.HELM_RELEASE} (ns: ${env.APP_NAMESPACE})"
                    echo "Helm chart    : ${env.HELM_CHART} (-f ${env.HELM_VALUES})"
                }
            }
        }

        stage('Checkout Application') {
            steps {
                dir('app') {
                    git branch: env.APP_REPO_BRANCH, url: env.APP_REPO_URL, credentialsId: 'github-credentials'
                    script {
                        // The image tag is the APPLICATION commit, not OAS-Infra's.
                        env.IMAGE_TAG = sh(script: "git rev-parse --short=7 HEAD", returnStdout: true).trim()
                    }
                }
                echo "Application commit (immutable image tag): ${env.IMAGE_TAG}"
            }
        }

        // Runs before the build on purpose: it is the cheapest stage to fail on, and the realm
        // script is idempotent and additive, so a realm applied ahead of a build that later fails
        // leaves the still-running old pod working. Skipped for services with no realm_setup_script.
        stage('Configure Keycloak Realm') {
            when { expression { env.REALM_SETUP_SCRIPT?.trim() } }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'ec2-deploy-key', keyFileVariable: 'SSH_KEY'),
                    usernamePassword(credentialsId: env.KC_ADMIN_CRED_ID,
                                     usernameVariable: 'KC_ADMIN_USER', passwordVariable: 'KC_ADMIN_PASS'),
                    string(credentialsId: env.KC_SECRET_CRED_ID, variable: 'KC_CLIENT_SECRET'),
                ]) {
                    // Build-scoped local port so two concurrent builds cannot fight over it.
                    script { env.KC_LOCAL_PORT = 18000 + (env.BUILD_NUMBER as Integer) % 1000 }
                    sh """
                        set -e
                        SSHCFG=\$(mktemp)
                        cat > \$SSHCFG <<SSHEOF
Host *
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  IdentityFile \${SSH_KEY}
SSHEOF

                        # Keycloak listens on the DB host's private address, so it is reached the
                        # same way a human reaches it: a port-forward through the bastion. A control
                        # socket makes the teardown deterministic instead of a pkill by pattern.
                        CTL=\$(mktemp -u)
                        # Every arm tolerates failure: the trap's last exit status would otherwise
                        # become the step's, turning a clean run into a red build.
                        cleanup() {
                            ssh -S "\$CTL" -O exit ${env.EC2_USER}@${env.BASTION_HOST} 2>/dev/null || true
                            rm -f "\$SSHCFG" 2>/dev/null || true
                            if [ -n "\${WORK:-}" ]; then rm -rf "\$WORK" 2>/dev/null || true; fi
                            return 0
                        }
                        trap cleanup EXIT

                        # ExitOnForwardFailure: without it ssh backgrounds happily on a busy local
                        # port and the script would then configure whatever else is listening there.
                        ssh -F \$SSHCFG -f -N -M -S "\$CTL" -o ExitOnForwardFailure=yes \\
                            -L ${env.KC_LOCAL_PORT}:${env.KC_HOST}:${env.KC_PORT} \\
                            ${env.EC2_USER}@${env.BASTION_HOST}

                        # Run from a copy outside the workspace: the script writes the client secret
                        # to a .env beside itself, which must not survive in the build workspace.
                        WORK=\$(mktemp -d)
                        cp app/${env.REALM_SETUP_SCRIPT} \$WORK/
                        KC=http://127.0.0.1:${env.KC_LOCAL_PORT} \\
                        REALM=${env.KC_REALM} \\
                        CLIENT=${env.KC_CLIENT_ID} \\
                        ADMIN_USER="\${KC_ADMIN_USER}" ADMIN_PASS="\${KC_ADMIN_PASS}" \\
                            bash \$WORK/\$(basename ${env.REALM_SETUP_SCRIPT})

                        # The script READS the client secret (it never rotates one), so this compares
                        # what Keycloak actually holds against the credential the deploy stage is
                        # about to bake into the k8s Secret. A drift here means the new pod cannot get
                        # an admin token — better to stop now than to fail at the first user publish.
                        LIVE=\$(sed -n 's/^KEYCLOAK_CLIENT_SECRET=//p' \$WORK/.env)
                        if [ "\$LIVE" != "\${KC_CLIENT_SECRET}" ]; then
                            echo "FATAL: Keycloak's client secret for ${env.KC_CLIENT_ID} does not match the"
                            echo "Jenkins credential '${env.KC_SECRET_CRED_ID}'. Update that credential (and"
                            echo "KEYCLOAK_CLIENT_SECRET in the Jenkins host .env) to the live value, then re-run."
                            exit 1
                        fi
                        echo "Realm ${env.KC_REALM} configured; client secret matches ${env.KC_SECRET_CRED_ID}."
                    """
                }
            }
        }

        // No separate Maven stage: the app's multi-stage Dockerfile runs `mvn package`.

        stage('Docker Build') {
            steps {
                dir('app') {
                    sh """
                        docker build \\
                            -t ${ECR_REPO}:${IMAGE_TAG} \\
                            -t ${ECR_REPO}:latest \\
                            .
                    """
                }
            }
        }

        stage('Push to ECR') {
            steps {
                // AWS creds are not ambient on the agent; provide them explicitly.
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                    sh """
                        aws ecr get-login-password --region ${ECR_REGION} | \\
                            docker login --username AWS --password-stdin ${ECR_REGISTRY}
                        docker push ${ECR_REPO}:${IMAGE_TAG}
                        docker push ${ECR_REPO}:latest
                    """
                }
            }
        }

        stage('Inject Secrets & Deploy') {
            steps {
                script {
                    // Secret strategy differs per service; the SSH deploy below is shared.
                    //   db-es    (catalogue): DB password + ES creds.
                    //   keycloak (auth)     : one client secret, no DB.
                    def creds = [ sshUserPrivateKey(credentialsId: 'ec2-deploy-key', keyFileVariable: 'SSH_KEY') ]
                    def secretCmd
                    if (env.SECRET_PROVIDER == 'db-es') {
                        creds << string(credentialsId: env.DB_CRED_ID, variable: 'DB_PASS')
                        creds << usernamePassword(credentialsId: 'ES_CREDENTIALS',
                                    usernameVariable: 'ES_USER', passwordVariable: 'ES_PASS')
                        secretCmd = """kubectl create secret generic ${env.SECRET_NAME} -n ${env.APP_NAMESPACE} \\
                            --from-literal=SPRING_DATASOURCE_USERNAME="${env.DB_USERNAME}" \\
                            --from-literal=SPRING_DATASOURCE_PASSWORD="\${DB_PASS}" \\
                            --from-literal=ELASTICSEARCH_USERNAME="\${ES_USER}" \\
                            --from-literal=ELASTICSEARCH_PASSWORD="\${ES_PASS}" \\
                            --dry-run=client -o yaml"""
                    } else if (env.SECRET_PROVIDER == 'keycloak') {
                        creds << string(credentialsId: env.KC_SECRET_CRED_ID, variable: 'KC_CLIENT_SECRET')
                        secretCmd = """kubectl create secret generic ${env.SECRET_NAME} -n ${env.APP_NAMESPACE} \\
                            --from-literal=KEYCLOAK_CLIENT_SECRET="\${KC_CLIENT_SECRET}" \\
                            --dry-run=client -o yaml"""
                    } else {
                        error("Unknown secrets.provider '${env.SECRET_PROVIDER}' for ${env.SERVICE}")
                    }

                    withCredentials(creds) {
                        sh """
                            set -e
                            # Private node via bastion ProxyJump. A temp ssh config applies the key +
                            # no-host-key-check to BOTH hops (-o flags don't propagate to the jump host).
                            SSHCFG=\$(mktemp)
                            cat > \$SSHCFG <<SSHEOF
Host *
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  IdentityFile \${SSH_KEY}
SSHEOF
                            SSH_OPTS="-F \$SSHCFG -o ProxyJump=${env.EC2_USER}@${env.BASTION_HOST}"
                            NODE="${env.EC2_USER}@${env.NODE_PRIVATE_IP}"

                            # Namespace + Secret (piped YAML — values never on remote argv / history).
                            ssh \$SSH_OPTS \$NODE \\
                                "kubectl create namespace ${env.APP_NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -"
                            ${secretCmd} \\
                              | ssh \$SSH_OPTS \$NODE "kubectl apply -n ${env.APP_NAMESPACE} -f -"

                            # Ship the Helm chart (rm old copy first; scp -r would nest into ~/helm/helm).
                            ssh \$SSH_OPTS \$NODE "rm -rf ~/helm"
                            scp \$SSH_OPTS -r ./${env.HELM_CHART} \$NODE:~/helm

                            # Deploy with the node's Helm; --wait blocks on rollout readiness.
                            ssh \$SSH_OPTS \$NODE \\
                                "helm upgrade --install ${env.HELM_RELEASE} ~/helm \\
                                    -f ~/helm/${env.HELM_VALUES} \\
                                    --namespace ${env.APP_NAMESPACE} --create-namespace \\
                                    --set image.repository=${env.ECR_REPO} \\
                                    --set image.tag=${env.IMAGE_TAG} \\
                                    --wait --timeout 600s"
                        """
                    }
                }
            }
        }

        // No in-pipeline smoke test: `helm --wait` gates pod readiness; verify through
        // nginx+Kong manually after deck-sync (real Kong keys live in kong/.env).
    }

    post {
        always {
            // Remove local images so the controller host does not accumulate layers.
            sh """
                docker rmi ${ECR_REPO}:${IMAGE_TAG} || true
                docker rmi ${ECR_REPO}:latest || true
            """
        }
        failure {
            echo "Pipeline failed — check stage logs above for details."
        }
        success {
            echo "Deployed ${env.SERVICE} image tag ${IMAGE_TAG} to node ${env.NODE_PRIVATE_IP} (via bastion ${env.BASTION_HOST}) successfully."
        }
    }
}
