// CI/CD for OAS catalogue services (agri-catalogue, org-user-notification-services, …).
//
// OAS-Infra is the pipeline owner: the Jenkins job checks out THIS repo, then
// this pipeline checks out the application repo (app_repo.url in
// services/<SERVICE>.config.yaml) into ./app, builds the image from the app's
// own multi-stage Dockerfile, pushes to ECR, and deploys via the shared Helm
// chart in this repo with the service's per-service values file.
//
// PRESS-BUTTON DEPLOY: this pipeline takes NO build parameters. Everything is
// resolved automatically:
//   * SERVICE      — from the job name via SERVICE_BY_JOB below.
//   * BASTION_HOST / NODE_PRIVATE_IP / NGINX_HOST — discovered from the EC2
//     Name tags (<NAME_PREFIX>-bastion / -K8s-Node / -nginx) using aws-credentials,
//     so restarts that change public IPs (no EIP) need no re-typing.
//   * SMOKE_API_KEY — read from the service config (auth.api_key, UAT non-secret).
// To onboard a service: add one SERVICE_BY_JOB entry + a pipelineJob in casc.yaml.
//
// Design notes:
//   * The image tag is the APPLICATION commit SHA (captured from ./app), NOT
//     env.GIT_COMMIT (which is OAS-Infra's SHA, since that is the job's SCM).
//   * Every build publishes two tags: the immutable <app-sha> and a moving
//     `latest`. Deploys always reference the immutable SHA so a running pod
//     traces back to an exact commit.
//   * AWS credentials are NOT ambient on the agent — every `aws` call is
//     wrapped in the `aws-credentials` binding.
//   * Helm is not installed on the Jenkins agent, so deploy runs the node's
//     own /usr/local/bin/helm over SSH.
pipeline {
    agent any

    environment {
        EC2_USER = "ubuntu"
        // The oas-uat environment's terraform name_prefix / cluster_name. The EC2
        // instances are tagged <NAME_PREFIX>-bastion / -nginx / -K8s-Node.
        NAME_PREFIX = "oas-uat"
    }

    stages {
        stage('Load Config') {
            steps {
                script {
                    // 1) Which service is this job? Derived from the job name (no build
                    //    param). agri's job is 'agri-catalogue-service' but its SERVICE
                    //    (config file) is 'agri-catalogue', so the mapping is explicit.
                    def SERVICE_BY_JOB = [
                        'agri-catalogue-service'         : 'agri-catalogue',
                        'org-user-notification-services' : 'org-user-notification-services',
                    ]
                    def jobLeaf = env.JOB_NAME.tokenize('/').last()
                    env.SERVICE = SERVICE_BY_JOB[jobLeaf]
                    if (!env.SERVICE) {
                        error("No SERVICE mapping for job '${jobLeaf}'. Add it to SERVICE_BY_JOB in jenkins/Jenkinsfile.")
                    }

                    def configFile = "services/${env.SERVICE}.config.yaml"
                    if (sh(script: "test -f ${configFile}", returnStatus: true) != 0) {
                        error("Service config not found: ${configFile}")
                    }
                    // Dependency-free reads from the single source of truth.
                    def cfg = { key ->
                        sh(
                            script: "grep -E '^[[:space:]]*${key}:' ${configFile} | head -1 | awk '{print \$2}'",
                            returnStdout: true
                        ).trim()
                    }
                    env.ECR_REPO_NAME   = cfg('ecr_repository_name')
                    env.ECR_REGION      = cfg('ecr_region')
                    env.HELM_RELEASE    = cfg('release_name')
                    env.HELM_CHART      = cfg('chart_path')      // shared: helm/oas-catalogue
                    env.HELM_VALUES     = cfg('values_file')     // e.g. values-agri-catalogue.yaml
                    env.APP_NAMESPACE   = cfg('namespace')
                    env.SECRET_NAME     = cfg('secret_name')     // <service>-secrets
                    env.SMOKE_PREFIX    = cfg('smoke_test_prefix')
                    env.SMOKE_API_KEY   = cfg('api_key')         // UAT role key (non-secret)
                    // DB username is non-secret (from config); the password comes from a
                    // per-service Jenkins secret 'db-password-<SERVICE>' (users differ:
                    // acs_user vs oas_user, so a single global credential can't serve both).
                    env.DB_USERNAME     = cfg('username')
                    env.DB_CRED_ID      = "db-password-${env.SERVICE}"
                    env.APP_REPO_URL    = cfg('url')
                    env.APP_REPO_BRANCH = cfg('branch')

                    // 2) Everything needing AWS: the account ID and the live host IPs,
                    //    discovered from EC2 Name tags (running instances only). No EIPs,
                    //    so this keeps working across instance restarts with new IPs.
                    withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                        env.AWS_ACCOUNT_ID = sh(
                            script: "aws sts get-caller-identity --query Account --output text",
                            returnStdout: true
                        ).trim()
                        def ec2ip = { nameTag, field ->
                            sh(
                                script: "aws ec2 describe-instances --region ${env.ECR_REGION} " +
                                        "--filters 'Name=tag:Name,Values=${nameTag}' 'Name=instance-state-name,Values=running' " +
                                        "--query 'Reservations[0].Instances[0].${field}' --output text",
                                returnStdout: true
                            ).trim()
                        }
                        env.BASTION_HOST    = ec2ip("${env.NAME_PREFIX}-bastion",  'PublicIpAddress')
                        env.NODE_PRIVATE_IP = ec2ip("${env.NAME_PREFIX}-K8s-Node", 'PrivateIpAddress')
                        env.NGINX_HOST      = ec2ip("${env.NAME_PREFIX}-nginx",    'PublicIpAddress')
                    }
                    def missing = { v -> v == null || v == '' || v == 'None' }
                    if (missing(env.BASTION_HOST)) {
                        error("Could not discover the bastion IP (tag ${env.NAME_PREFIX}-bastion, running). " +
                              "Is the instance up, and does aws-credentials allow ec2:DescribeInstances?")
                    }
                    if (missing(env.NODE_PRIVATE_IP)) {
                        error("Could not discover the k8s node private IP (tag ${env.NAME_PREFIX}-K8s-Node, running).")
                    }
                    env.ECR_REGISTRY = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.ECR_REGION}.amazonaws.com"
                    env.ECR_REPO     = "${env.ECR_REGISTRY}/${env.ECR_REPO_NAME}"

                    echo "Service       : ${env.SERVICE}"
                    echo "Deploy target : ${env.NODE_PRIVATE_IP} via bastion ${env.BASTION_HOST}"
                    echo "nginx (smoke) : ${env.NGINX_HOST}"
                    echo "ECR repository: ${env.ECR_REPO}"
                    echo "Helm release  : ${env.HELM_RELEASE} (ns: ${env.APP_NAMESPACE})"
                    echo "Helm chart    : ${env.HELM_CHART} (-f ${env.HELM_VALUES})"
                }
            }
        }

        stage('Checkout Application') {
            steps {
                dir('app') {
                    git branch: env.APP_REPO_BRANCH, url: env.APP_REPO_URL, credentialsId: 'github-credentials'
                    script {
                        // The image tag is the APPLICATION commit, not OAS-Infra's.
                        env.IMAGE_TAG = sh(script: "git rev-parse --short=7 HEAD", returnStdout: true).trim()
                    }
                }
                echo "Application commit (immutable image tag): ${env.IMAGE_TAG}"
            }
        }

        // NOTE: there is intentionally no separate Maven "Build & Test" stage.
        // The application's multi-stage Dockerfile runs `mvn clean package`
        // inside its build stage, so building the JAR on the agent first would
        // just be thrown away by `docker build`.

        stage('Docker Build') {
            steps {
                dir('app') {
                    sh """
                        docker build \\
                            -t ${ECR_REPO}:${IMAGE_TAG} \\
                            -t ${ECR_REPO}:latest \\
                            .
                    """
                }
            }
        }

        stage('Push to ECR') {
            steps {
                // AWS creds are not ambient on the agent; provide them explicitly.
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding', credentialsId: 'aws-credentials']]) {
                    sh """
                        aws ecr get-login-password --region ${ECR_REGION} | \\
                            docker login --username AWS --password-stdin ${ECR_REGISTRY}
                        docker push ${ECR_REPO}:${IMAGE_TAG}
                        docker push ${ECR_REPO}:latest
                    """
                }
            }
        }

        stage('Inject Secrets & Deploy') {
            steps {
                withCredentials([
                    string(credentialsId: env.DB_CRED_ID, variable: 'DB_PASS'),
                    usernamePassword(credentialsId: 'ES_CREDENTIALS', usernameVariable: 'ES_USER', passwordVariable: 'ES_PASS'),
                    sshUserPrivateKey(credentialsId: 'ec2-deploy-key', keyFileVariable: 'SSH_KEY')
                ]) {
                    sh """
                        set -e
                        # The node is private: reach it via the bastion (ProxyJump). Use a temp
                        # ssh config with "Host *" so host-key checking is disabled and the shared
                        # key is applied to BOTH hops — command-line -o options do NOT propagate to
                        # the ProxyJump/jump host, which caused "Host key verification failed".
                        SSHCFG=\$(mktemp)
                        cat > \$SSHCFG <<SSHEOF
Host *
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  IdentityFile \${SSH_KEY}
SSHEOF
                        SSH_OPTS="-F \$SSHCFG -o ProxyJump=${EC2_USER}@${env.BASTION_HOST}"
                        NODE="${EC2_USER}@${env.NODE_PRIVATE_IP}"

                        # 1) Ensure the target namespace exists (idempotent).
                        ssh \$SSH_OPTS \$NODE \\
                            "kubectl create namespace ${APP_NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -"

                        # 2) Build the Secret manifest LOCALLY (values come from the
                        #    masked withCredentials env vars) and pipe only the YAML
                        #    over SSH. Secret values never appear in remote argv or the
                        #    node's shell history, and are masked in the Jenkins console.
                        kubectl create secret generic ${SECRET_NAME} -n ${APP_NAMESPACE} \\
                            --from-literal=SPRING_DATASOURCE_USERNAME="${DB_USERNAME}" \\
                            --from-literal=SPRING_DATASOURCE_PASSWORD="\${DB_PASS}" \\
                            --from-literal=ELASTICSEARCH_USERNAME="\${ES_USER}" \\
                            --from-literal=ELASTICSEARCH_PASSWORD="\${ES_PASS}" \\
                            --dry-run=client -o yaml \\
                          | ssh \$SSH_OPTS \$NODE "kubectl apply -n ${APP_NAMESPACE} -f -"

                        # 3) Ship the Helm chart to the node. Remove any previous copy first
                        #    (scp -r nests into ~/helm/helm if it already exists).
                        ssh \$SSH_OPTS \$NODE "rm -rf ~/helm"
                        scp \$SSH_OPTS -r ./${HELM_CHART} \$NODE:~/helm

                        # 4) Deploy with the node's own Helm. Shared chart parameterized by
                        #    the per-service values file (-f). image.repository always set;
                        #    immutable SHA tag; --wait blocks on rollout readiness.
                        ssh \$SSH_OPTS \$NODE \\
                            "helm upgrade --install ${HELM_RELEASE} ~/helm \\
                                -f ~/helm/${HELM_VALUES} \\
                                --namespace ${APP_NAMESPACE} --create-namespace \\
                                --set image.repository=${ECR_REPO} \\
                                --set image.tag=${IMAGE_TAG} \\
                                --wait --timeout 600s"
                    """
                }
            }
        }

        stage('Smoke Test') {
            steps {
                script {
                    if (!env.SMOKE_API_KEY?.trim() || !env.NGINX_HOST?.trim() || env.NGINX_HOST == 'None') {
                        echo "Smoke key or nginx host unavailable — skipping the through-Kong smoke test. " +
                             "(helm --wait already gated on pod readiness.)"
                    } else {
                        // Hit the app through the public nginx entrypoint + Kong (key-auth).
                        sh """
                            for i in \$(seq 1 10); do
                                if curl -sf http://${env.NGINX_HOST}/${env.SMOKE_PREFIX}/v1/read/smoketest \\
                                      -H "apikey: ${env.SMOKE_API_KEY}"; then
                                    echo "Smoke test passed."
                                    exit 0
                                fi
                                echo "Smoke test attempt \$i failed; retrying in 15s..."
                                sleep 15
                            done
                            echo "Smoke test failed after retries."
                            exit 1
                        """
                    }
                }
            }
        }
    }

    post {
        always {
            // Remove local images so the controller host does not accumulate layers.
            sh """
                docker rmi ${ECR_REPO}:${IMAGE_TAG} || true
                docker rmi ${ECR_REPO}:latest || true
            """
        }
        failure {
            echo "Pipeline failed — check stage logs above for details."
        }
        success {
            echo "Deployed ${env.SERVICE} image tag ${IMAGE_TAG} to node ${env.NODE_PRIVATE_IP} (via bastion ${env.BASTION_HOST}) successfully."
        }
    }
}
