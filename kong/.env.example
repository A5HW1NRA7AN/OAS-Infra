# Copy to kong/.env (gitignored). The 3 role API keys consumed by deck-sync.sh.
# Generate strong keys:  openssl rand -hex 24
# Hand these (with the base URL http://<nginx-EIP>) to developers per role.

OAS_USER_API_KEY=change-me-user-readonly
OAS_ADMIN_API_KEY=change-me-admin-crud
OAS_SUPERADMIN_API_KEY=change-me-superadmin
