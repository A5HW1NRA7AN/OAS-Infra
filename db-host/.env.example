# Copy to db-host/.env (gitignored) and set real values.
# scripts/setup-cluster.sh delivers this file to the DB host alongside the
# compose stack; it is never baked into user_data.

# Postgres bootstrap superuser
POSTGRES_SUPER_USER=postgres
POSTGRES_SUPER_PASSWORD=change-me-super

# Per-tenant DB passwords (must match the k8s Secrets injected by Jenkins:
#   acs_* -> DB_CREDENTIALS for agri, oas_* -> DB_CREDENTIALS for organisation)
ACS_DB_PASSWORD=change-me-acs
OAS_DB_PASSWORD=change-me-oas
KONG_DB_PASSWORD=change-me-kong

# pgAdmin login (GUI reached via bastion SSH tunnel only)
PGADMIN_EMAIL=admin@example.com   # pgAdmin rejects reserved TLDs like .local
PGADMIN_PASSWORD=change-me-pgadmin
